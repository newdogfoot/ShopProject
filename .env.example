# Copy to .env.local and fill in what you need. Every value is optional.

# Claude API key. Leave empty to run in template mode (no AI calls; built-in
# Korean explanations, hints and word problems are used instead).
ANTHROPIC_API_KEY=

# Model used for every AI feature.
CLAUDE_MODEL=claude-opus-5-5

# Set to "false" to turn AI features off even when a key is present.
AI_ENABLED=true

# PostgreSQL connection string for production. Leave empty to use a local
# embedded database (PGlite) stored in ./.data/pglite.
DATABASE_URL=

# Directory for the local PGlite database when DATABASE_URL is empty.
PGLITE_DIR=./.data/pglite
